build/
dist/
*.egg-info/

.DS_Store

.coverage
.coverage.*

# template/ is a resolvable uv project, so a uv command run from inside it
# writes template/uv.lock. init.sh copies template/ into each new project, so a
# committed lock would seed every scaffolded repo with stale pins. Ignore it
# here, not in template/.gitignore: scaffolded projects commit their own uv.lock.
/template/uv.lock

.env
.env.*
!.env.example
